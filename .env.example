# Repository and external input locations
COATING_PROJECT_ROOT=/path/to/2030-coating
COATING_DATA_DIR=/path/to/private/coating_workbooks
COATING_PRIMER_FILE=primer.xlsx
COATING_TOPCOAT_FILE=topcoat.xlsx
COATING_SHEET_NAME=coating_samples

# Optional literature and document inputs
COATING_LITERATURE_DIR=/path/to/private/literature_pdfs
COATING_LITERATURE_TEXT_DIR=/path/to/generated/literature_text
COATING_LITERATURE_MATRIX_INPUT=/path/to/private/literature_matrix.csv
COATING_REFERENCE_OVERRIDES=/path/to/private/reference_overrides.json
COATING_TEMPLATE_DOCX=/path/to/private/Manuscript_Ti_CN.docx
CROSSREF_MAILTO=researcher@example.org

# Optional runtime controls
COATING_N_BOOT=200
COATING_N_PERM=100
COATING_PYTHON=python3
COATING_CONDA_SH=/path/to/conda.sh
COATING_CONDA_ENV=coating
